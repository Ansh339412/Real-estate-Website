# Copy to .env.local and fill in both values from Supabase: Project Settings > API.
# The anon key is public by design; Row Level Security in supabase/schema.sql is what protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER add the service_role / secret key here or anywhere in this project.
# Anything starting with VITE_ is copied into the public JavaScript bundle.
